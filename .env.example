# HTTP port provided by your host (defaults to 4400 locally)
PORT=4400

# Optional: enables structured OpenAI compilation. Without it, ChaosForge uses
# its deterministic local semantic compiler so judges can still test every flow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required before enabling real Twitch EventSub webhook subscriptions.
# Generate a high-entropy value; never use a committed development default.
TWITCH_EVENTSUB_SECRET=

# Required for authenticated Twitch chat replies and EventSub subscription setup.
# Keep these only in the deployment's secret environment variables.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
